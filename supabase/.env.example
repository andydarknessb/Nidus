# Copy to supabase/.env (gitignored) and restart the stack. See docs/google-sign-in.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Connecting a Calendar Account (calendar-connect Edge Function). Read by the function, not the
# Auth service: local, run `supabase functions serve --env-file supabase/.env`; hosted, `supabase
# secrets set`. Create a Google OAuth client (Web application) with the Calendar API enabled and
# add ${CALENDAR_CONNECT_URL}/callback as an authorised redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Random, 32+ characters. Signs the consent link's state parameter.
CALENDAR_STATE_SECRET=
# Where the app is served; the parent's own consent flow returns here.
APP_URL=http://127.0.0.1:5173
# Optional: the function's browser-reachable URL. Defaults to $SUPABASE_URL/functions/v1/calendar-connect.
# CALENDAR_CONNECT_URL=http://127.0.0.1:54321/functions/v1/calendar-connect
